{
  "name": "tiptap-yjs-snapshot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Portable open-source V2 revision history practice code for Tiptap and Yjs",
  "workspaces": ["packages/*"],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "tsx src/server/main.ts",
    "check:public": "node scripts/check-public-surface.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "build:packages": "npm run build --workspaces --if-present",
    "build": "npm run typecheck && npm run build:packages && vite build"
  },
  "dependencies": {
    "@hocuspocus/transformer": "3.4.3",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-collaboration": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "lit": "3.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.18.3",
    "y-prosemirror": "1.3.7",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.0.10",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/ws": "8.18.1",
    "concurrently": "9.2.1",
    "esbuild-sass-plugin": "3.3.1",
    "jsdom": "26.1.0",
    "sass": "1.90.0",
    "tsup": "8.5.0",
    "tsx": "4.21.0",
    "typescript": "5.8.3",
    "vite": "7.3.1",
    "vitest": "3.2.4"
  },
  "overrides": {
    "@tiptap/core": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/extensions": "3.29.2",
    "@tiptap/extension-blockquote": "3.29.2",
    "@tiptap/extension-bold": "3.29.2",
    "@tiptap/extension-bubble-menu": "3.29.2",
    "@tiptap/extension-bullet-list": "3.29.2",
    "@tiptap/extension-code": "3.29.2",
    "@tiptap/extension-code-block": "3.29.2",
    "@tiptap/extension-document": "3.29.2",
    "@tiptap/extension-dropcursor": "3.29.2",
    "@tiptap/extension-floating-menu": "3.29.2",
    "@tiptap/extension-gapcursor": "3.29.2",
    "@tiptap/extension-hard-break": "3.29.2",
    "@tiptap/extension-heading": "3.29.2",
    "@tiptap/extension-horizontal-rule": "3.29.2",
    "@tiptap/extension-italic": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-list": "3.29.2",
    "@tiptap/extension-list-item": "3.29.2",
    "@tiptap/extension-list-keymap": "3.29.2",
    "@tiptap/extension-ordered-list": "3.29.2",
    "@tiptap/extension-paragraph": "3.29.2",
    "@tiptap/extension-strike": "3.29.2",
    "@tiptap/extension-text": "3.29.2",
    "@tiptap/extension-underline": "3.29.2"
  }
}
